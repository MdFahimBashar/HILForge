# Local-development defaults only. Replace credentials before using this stack
# anywhere beyond a private development machine.
PULSEHUNTER_IMAGE_TAG=local
PULSEHUNTER_API_PORT=8000
PULSEHUNTER_ENVIRONMENT=development
PULSEHUNTER_LOG_LEVEL=INFO

POSTGRES_DB=hilforge
POSTGRES_USER=hilforge
POSTGRES_PASSWORD=hilforge
PULSEHUNTER_DATABASE_URL=postgresql+psycopg://hilforge:hilforge@postgres:5432/hilforge
PULSEHUNTER_REDIS_URL=redis://redis:6379/0

PULSEHUNTER_JOB_TIMEOUT_SECONDS=3
PULSEHUNTER_JOB_MAX_ATTEMPTS=3
PULSEHUNTER_RETRY_BACKOFF_SECONDS=1
PULSEHUNTER_RETRY_BACKOFF_MAX_SECONDS=10
PULSEHUNTER_JOB_LEASE_GRACE_SECONDS=5
PULSEHUNTER_HEARTBEAT_TIMEOUT_SECONDS=10
PULSEHUNTER_HEARTBEAT_SCAN_INTERVAL_SECONDS=3
PULSEHUNTER_RECONCILE_INTERVAL_SECONDS=2

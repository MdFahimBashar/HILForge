# Local-development defaults only. Replace credentials before using this stack
# anywhere beyond a private development machine.
HILFORGE_IMAGE_TAG=local
HILFORGE_API_PORT=8000
HILFORGE_ENVIRONMENT=development
HILFORGE_LOG_LEVEL=INFO

POSTGRES_DB=hilforge
POSTGRES_USER=hilforge
POSTGRES_PASSWORD=hilforge
HILFORGE_DATABASE_URL=postgresql+psycopg://hilforge:hilforge@postgres:5432/hilforge
HILFORGE_REDIS_URL=redis://redis:6379/0

HILFORGE_JOB_TIMEOUT_SECONDS=3
HILFORGE_JOB_MAX_ATTEMPTS=3
HILFORGE_RETRY_BACKOFF_SECONDS=1
HILFORGE_RETRY_BACKOFF_MAX_SECONDS=10
HILFORGE_JOB_LEASE_GRACE_SECONDS=5
HILFORGE_HEARTBEAT_TIMEOUT_SECONDS=10
HILFORGE_HEARTBEAT_SCAN_INTERVAL_SECONDS=3
HILFORGE_RECONCILE_INTERVAL_SECONDS=2
